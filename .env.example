PORT=3018

MONGODB_URI=mongodb+srv://atm_crackers_app:<YOUR_PASSWORD>@<YOUR_CLUSTER>.mongodb.net/atm_crackers_dev?appName=atm-crackers-dev

# File storage: local for development, s3 for AWS S3
FILE_STORAGE=local
APP_BASE_URL=http://localhost:3018

# Required when FILE_STORAGE=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=
# true for a public bucket; false/empty uses one-hour signed URLs
AWS_S3_PUBLIC=false
